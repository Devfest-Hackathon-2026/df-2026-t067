{
  "name": "tourism-quest-server",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "26.7.0",
    "npm": "11.19.0"
  },
  "scripts": {
    "dev": "npm run build && npm start",
    "start": "node dist/server/src/main.js",
    "vertex:trial": "node --env-file-if-exists=../.env.local dist/server/src/vertex-trial-cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --config .oxlintrc.json --deny-warnings src test",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/server/test/*.test.js",
    "test:cloud-storage": "tsc -p tsconfig.test.json && node --test dist-test/server/test/cloud-storage.smoke.js",
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@google-cloud/storage": "8.4.0",
    "firebase-admin": "14.5.0",
    "google-auth-library": "11.3.3",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "26.0.0",
    "oxlint": "1.89.0",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "protobufjs": false,
    "@firebase/util": false
  }
}
